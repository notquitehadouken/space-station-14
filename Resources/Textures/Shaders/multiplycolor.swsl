// This shader is intended to be used with partial alpha (0.0f to 1.0f exclusive) values.

uniform sampler2D SCREEN_TEXTURE;
uniform vec4 modulate;

void fragment() {
    highp vec4 spriteColor = zTexture(UV);

    if (spriteColor.a == 0.0 || modulate.a == 0.0) {
        discard;
    }

    highp vec4 screenColor = zTexture(SCREEN_TEXTURE, FRAGCOORD.xy * SCREEN_PIXEL_SIZE);

    COLOR.xyz = mix(screenColor.xyz, spriteColor.xyz, modulate.a * spriteColor.a);
    COLOR.a = 1.0;
}
